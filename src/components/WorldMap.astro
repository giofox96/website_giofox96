---
// Map of places: where I studied, worked and exhibited, and where the projects are sited.
// Projected at build time with d3-geo; the page only receives static SVG.
import { geoGraticule10, geoNaturalEarth1, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import land110 from 'world-atlas/land-110m.json';
import land50 from 'world-atlas/land-50m.json';
import profile from '../data/profile.json';
import { allProjects, projectUrl } from '../lib';
import Pin from './Pin.astro';

type Kind = 'work' | 'study' | 'show' | 'project';
type Entry = { kind: Kind; title: string; sub: string; href?: string };
type Place = { city: string; lat: number; lon: number; entries: Entry[] };

const places = new Map<string, Place>();
const add = (p: { city: string; lat: number; lon: number }, e: Entry) => {
  const at = places.get(p.city) ?? { ...p, entries: [] };
  at.entries.push(e);
  places.set(p.city, at);
};
type Cv = { period: string; role: string; where: string; place?: { city: string; lat: number; lon: number } };
for (const e of profile.experience as Cv[]) if (e.place) add(e.place, { kind: 'work', title: e.role, sub: `${e.where} · ${e.period}` });
for (const e of profile.education as Cv[]) if (e.place) add(e.place, { kind: 'study', title: e.role, sub: `${e.where} · ${e.period}` });
type Show = { year: string; title: string; where: string; place?: { city: string; lat: number; lon: number } };
for (const x of profile.exhibitions as Show[]) if (x.place) add(x.place, { kind: 'show', title: x.title, sub: `${x.where} · ${x.year}` });

const projects = await allProjects();
for (const p of projects) {
  if (!p.data.coords) continue;
  const [lat, lon] = p.data.coords;
  const city = p.data.city ?? p.data.location?.split(',').at(-1)?.trim() ?? p.data.title;
  // Projects in a city I also lived in join that place; the rest get their own.
  const near = [...places.values()].find((q) => Math.hypot(q.lat - lat, q.lon - lon) < 0.6);
  add(near ?? { city, lat, lon }, { kind: 'project', title: p.data.title, sub: `${p.data.type} · ${p.data.year}`, href: projectUrl(p) });
}

// The journey: CV places in the order I moved through them.
const year = (s: string) => Number(s.match(/\d{4}/)?.[0] ?? 0);
const steps = [...(profile.education as Cv[]), ...(profile.experience as Cv[])]
  .filter((e) => e.place)
  .map((e, i) => ({ y: year(e.period), i, p: e.place! }))
  .sort((a, b) => a.y - b.y || b.i - a.i)
  .map((s) => [s.p.lon, s.p.lat] as [number, number])
  .filter((c, i, a) => i === 0 || c[0] !== a[i - 1][0] || c[1] !== a[i - 1][1]);

const kindOf = (pl: Place): Kind =>
  pl.entries.some((e) => e.kind === 'work') ? 'work' : pl.entries.some((e) => e.kind === 'study') ? 'study' : pl.entries.some((e) => e.kind === 'show') ? 'show' : 'project';

const W = 1000;
const sphere = { type: 'Sphere' } as const;
const corners = (w: number, s: number, e: number, n: number) => ({ type: 'MultiPoint' as const, coordinates: [[w, s], [e, s], [e, n], [w, n], [(w + e) / 2, n], [(w + e) / 2, s]] });
const views = [
  { id: 'world', label: 'World', h: 470, fit: corners(-170, -50, 180, 78), land: land110 },
  { id: 'med', label: 'Mediterranean', h: 560, fit: corners(-8, 22, 42, 52), land: land50 },
].map((v) => {
  const proj = geoNaturalEarth1().fitExtent([[24, 24], [W - 24, v.h - 24]], v.fit);
  proj.clipExtent([[0, 0], [W, v.h]]);
  const path = geoPath(proj);
  const topo = v.land as any;
  const landPath = path(feature(topo, topo.objects.land) as any) ?? '';
  const grat = path(geoGraticule10()) ?? '';
  const outline = path(sphere) ?? '';
  // One arc per move. A leg between two cities already joined bends further out, and a return
  // trip bends to the other side, so repeated moves never draw on top of each other.
  const seen = new Map<string, number>();
  const legs = steps.slice(1).flatMap((to, i) => {
    const a = proj(steps[i]), b = proj(to);
    if (!a || !b) return [];
    const key = [String(steps[i]), String(to)].sort().join('|');
    const n = seen.get(key) ?? 0;
    seen.set(key, n + 1);
    const k = 0.22 + 0.18 * n;
    const r = (v: number) => Math.round(v * 10) / 10;
    const cx = (a[0] + b[0]) / 2 - (b[1] - a[1]) * k, cy = (a[1] + b[1]) / 2 + (b[0] - a[0]) * k;
    return [`M${r(a[0])} ${r(a[1])}Q${r(cx)} ${r(cy)} ${r(b[0])} ${r(b[1])}`];
  });
  const pins = [...places.values()]
    .map((pl) => {
      const xy = proj([pl.lon, pl.lat]);
      return xy && { ...pl, x: Math.round(xy[0]), y: Math.round(xy[1]), kind: kindOf(pl) };
    })
    .filter((p) => p !== null && p.x >= 0 && p.x <= W && p.y >= 0 && p.y <= v.h) as (Place & { x: number; y: number; kind: Kind })[];
  // Label the places I lived in first; skip a label that would sit on top of one already placed.
  const rank: Record<Kind, number> = { work: 0, study: 0, show: 1, project: 2 };
  const placed: { x: number; y: number }[] = [];
  const labelled = new Set<string>();
  const order = new Map<string, number>(); // label priority, reused by the client-side placement
  [...pins].sort((a, b) => rank[a.kind] - rank[b.kind] || b.entries.length - a.entries.length).forEach((p, i) => {
    order.set(p.city, i);
    if (placed.every((q) => Math.abs(q.x - p.x) > 80 || Math.abs(q.y - p.y) > 22)) { placed.push(p); labelled.add(p.city); }
  });
  return { ...v, landPath, grat, outline, legs, pins, labelled, order };
});
const kinds: { id: Kind; label: string }[] = [
  { id: 'work', label: 'Work' },
  { id: 'study', label: 'Study' },
  { id: 'show', label: 'Exhibition' },
  { id: 'project', label: 'Project site' },
];
---
<div class="atlas" id="atlas" data-view="world">
  <div class="space-bar">
    <ul class="atlas-key mono" aria-label="Legend: pick one to highlight it">
      {kinds.map((k) => <li><button type="button" data-focus={k.id} aria-pressed="false"><svg viewBox="-8 -8 16 16" aria-hidden="true"><Pin kind={k.id} /></svg>{k.label}</button></li>)}
      <li><button type="button" data-focus="path" aria-pressed="false"><svg viewBox="0 0 24 8" aria-hidden="true"><path d="M1 4h22" class="route" /></svg>Path, 2017 to today</button></li>
    </ul>
    <div class="atlas-ctl">
      <div role="group" aria-label="Map extent">
        {views.map((v, i) => <button type="button" class="chip" data-view={v.id} aria-pressed={String(i === 0)}>{v.label}</button>)}
      </div>
      <div role="group" aria-label="Zoom">
        <button type="button" class="chip" data-zoom="in" aria-label="Zoom in">+</button>
        <button type="button" class="chip" data-zoom="out" aria-label="Zoom out">−</button>
        <button type="button" class="chip" data-zoom="reset" aria-label="Reset zoom">Reset</button>
      </div>
    </div>
  </div>
  {views.map((v) => (
    <svg class="atlas-svg" data-view={v.id} viewBox={`0 0 ${W} ${v.h}`} role="group" aria-label={`${v.label} map of places`}>
      <g class="zoom">
        <path d={v.outline} class="sea" />
        <path d={v.grat} class="grat" />
        <path d={v.landPath} class="land" />
        {v.legs.map((d, i) => <path d={d} class="route" pathLength="1" style={`--d:${(i * 0.3).toFixed(1)}s`} />)}
      </g>
      {v.pins.map((p) => (
        <g
          class="pin"
          tabindex="0"
          role="button"
          aria-label={`${p.city}: ${p.entries.map((e) => e.title).join(', ')}`}
          transform={`translate(${p.x} ${p.y})`}
          data-x={p.x}
          data-y={p.y}
          data-city={p.city}
          data-kinds={[...new Set(p.entries.map((e) => e.kind))].join(' ')}
          data-rank={v.order.get(p.city)}
        >
          <circle r="14" class="hit" />
          <g class="mk"><Pin kind={p.kind} /></g>
          <text x="9" y="4" class:list={{ extra: !v.labelled.has(p.city) }}>{p.city}</text>
        </g>
      ))}
    </svg>
  ))}
  <div class="atlas-tip" hidden></div>
  <script type="application/json" is:inline class="atlas-data" set:html={JSON.stringify(Object.fromEntries([...places.values()].map((p) => [p.city, p.entries]))).replace(/</g, '\\u003c')} />
  <p class="space-cap mono">
    <span>Natural Earth projection · land from Natural Earth via world-atlas.</span>
    <span>{places.size} places · {[...places.values()].reduce((n, p) => n + p.entries.length, 0)} entries</span>
  </p>
</div>

<script>
  type Entry = { kind: string; title: string; sub: string; href?: string };
  const root = document.getElementById('atlas');
  if (root) {
    const data: Record<string, Entry[]> = JSON.parse(root.querySelector('.atlas-data')!.textContent ?? '{}');
    const tip = root.querySelector<HTMLElement>('.atlas-tip')!;
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { root.classList.add('on'); io.disconnect(); }
    }, { threshold: 0.3 });
    io.observe(root);

    root.classList.add('js');
    root.querySelectorAll<HTMLButtonElement>('button[data-view]').forEach((b) =>
      b.addEventListener('click', () => {
        root.dataset.view = b.dataset.view;
        root.querySelectorAll('button[data-view]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        zooms.get(b.dataset.view!)?.(1); // re-place the labels now that this map is visible and measurable
        tip.hidden = true;
      }),
    );

    // Legend as a filter: one kind (or the path) stays lit, the rest dims. Click it again to clear.
    const keys = [...root.querySelectorAll<HTMLButtonElement>('button[data-focus]')];
    keys.forEach((b) =>
      b.addEventListener('click', () => {
        const same = root.dataset.focus === b.dataset.focus;
        if (same) delete root.dataset.focus;
        else root.dataset.focus = b.dataset.focus;
        keys.forEach((x) => x.setAttribute('aria-pressed', String(!same && x === b)));
        root.querySelectorAll<SVGGElement>('.pin').forEach((p) =>
          p.classList.toggle('lit', !same && (p.dataset.kinds ?? '').split(' ').includes(b.dataset.focus!)),
        );
      }),
    );

    // Zoom and pan. The land and routes scale inside `.zoom`; pins are moved instead, so they keep their size.
    let dragged = false;
    const zooms = new Map<string, (f: number, at?: DOMPoint) => void>();
    root.querySelectorAll<SVGSVGElement>('.atlas-svg').forEach((svg) => {
      const g = svg.querySelector<SVGGElement>('.zoom')!;
      const pins = [...svg.querySelectorAll<SVGGElement>('.pin')].sort((a, b) => +a.dataset.rank! - +b.dataset.rank!);
      const { width: W, height: H } = svg.viewBox.baseVal;
      let k = 1, x = 0, y = 0;
      const apply = () => {
        x = Math.min(0, Math.max(W - W * k, x));
        y = Math.min(0, Math.max(H - H * k, y));
        g.setAttribute('transform', `translate(${x} ${y}) scale(${k})`);
        // Pins stay on their true location. Each label, in priority order, takes the first side of its
        // pin (right, left, above, below) where it hits no marker, no placed label and no map edge;
        // if none is free it hides until zooming in makes room. The card on hover still names the place.
        type Box = [number, number, number, number]; // x0, y0, x1, y1
        const hit = (a: Box, b: Box) => a[0] < b[2] && b[0] < a[2] && a[1] < b[3] && b[1] < a[3];
        const at = pins.map((p) => [x + +p.dataset.x! * k, y + +p.dataset.y! * k]);
        const taken: Box[] = at.map(([px, py]) => [px - 7, py - 7, px + 7, py + 7]);
        pins.forEach((p, i) => {
          const [px, py] = at[i];
          p.setAttribute('transform', `translate(${px} ${py})`);
          const t = p.querySelector('text')!;
          const fs = parseFloat(getComputedStyle(t).fontSize) || 13;
          t.style.display = ''; // a hidden label measures 0 wide
          const w = (svg.clientWidth && t.getComputedTextLength()) || (t.textContent ?? '').length * fs * 0.6;
          const h = fs, gap = 9;
          // [text x, text baseline y] relative to the pin
          const sides = [[gap, h * 0.35], [-gap - w, h * 0.35], [-w / 2, -gap], [-w / 2, gap + h * 0.7]];
          const own = taken[i];
          const free = sides.find(([tx, ty]) => {
            const b: Box = [px + tx - 2, py + ty - h * 0.9, px + tx + w + 2, py + ty + h * 0.35];
            if (b[0] < 0 || b[1] < 0 || b[2] > W || b[3] > H) return false;
            return !taken.some((o) => o !== own && hit(o, b));
          });
          t.style.display = free ? '' : 'none';
          if (!free) return;
          t.setAttribute('x', String(free[0]));
          t.setAttribute('y', String(free[1]));
          taken.push([px + free[0] - 2, py + free[1] - h * 0.9, px + free[0] + w + 2, py + free[1] + h * 0.35]);
        });
        svg.classList.toggle('zoomed', k > 1);
        svg.style.setProperty('--k', String(k));
        tip.hidden = true;
      };
      const local = (cx: number, cy: number) => new DOMPoint(cx, cy).matrixTransform(svg.getScreenCTM()!.inverse());
      const zoom = (f: number, at = new DOMPoint(W / 2, H / 2)) => {
        const nk = f === 0 ? 1 : Math.min(8, Math.max(1, k * f));
        x = at.x - ((at.x - x) * nk) / k;
        y = at.y - ((at.y - y) * nk) / k;
        k = nk;
        apply();
      };
      zooms.set(svg.dataset.view!, zoom);
      apply();
      svg.addEventListener('wheel', (e) => {
        if (k === 1 && e.deltaY > 0) return; // let the page scroll when there is nothing to zoom out of
        e.preventDefault();
        zoom(Math.exp(-e.deltaY * 0.002), local(e.clientX, e.clientY));
      }, { passive: false });
      svg.addEventListener('dblclick', (e) => zoom(2, local(e.clientX, e.clientY)));

      // One pointer pans, two pointers pinch.
      const ptrs = new Map<number, DOMPoint>();
      let start = 0;
      svg.addEventListener('pointerdown', (e) => {
        if (k > 1) e.preventDefault(); // no text selection while panning
        ptrs.set(e.pointerId, local(e.clientX, e.clientY));
        dragged = false;
        start = 0;
      });
      window.addEventListener('pointermove', (e) => {
        const prev = ptrs.get(e.pointerId);
        if (!prev) return;
        const now = local(e.clientX, e.clientY);
        if (ptrs.size === 2) {
          const [a, b] = [...ptrs.values()];
          const d0 = Math.hypot(a.x - b.x, a.y - b.y);
          ptrs.set(e.pointerId, now);
          const [c, d] = [...ptrs.values()];
          if (d0) zoom(Math.hypot(c.x - d.x, c.y - d.y) / d0, new DOMPoint((c.x + d.x) / 2, (c.y + d.y) / 2));
          dragged = true;
          return;
        }
        start += Math.hypot(now.x - prev.x, now.y - prev.y);
        if (k > 1 && start > 4) { dragged = true; x += now.x - prev.x; y += now.y - prev.y; apply(); }
        // The CTM does not change while panning, so the new point is measured in the same frame.
        ptrs.set(e.pointerId, now);
      });
      const up = (e: PointerEvent) => ptrs.delete(e.pointerId);
      window.addEventListener('pointerup', up);
      window.addEventListener('pointercancel', up);
    });
    root.querySelectorAll<HTMLButtonElement>('button[data-zoom]').forEach((b) =>
      b.addEventListener('click', () => zooms.get(root.dataset.view!)?.({ in: 1.6, out: 1 / 1.6, reset: 0 }[b.dataset.zoom!]!)),
    );
    // Label widths change once the web font arrives.
    document.fonts.ready.then(() => zooms.forEach((z) => z(1)));
    // A drag that ends on a pin is a pan, not a click.
    root.addEventListener('click', (e) => { if (dragged) { e.stopPropagation(); dragged = false; } }, true);

    let pinned: Element | null = null;
    const show = (pin: SVGGElement) => {
      const entries = data[pin.dataset.city ?? ''] ?? [];
      tip.replaceChildren();
      const h = document.createElement('strong');
      h.className = 'mono';
      h.textContent = pin.dataset.city ?? '';
      tip.append(h);
      for (const e of entries) {
        const row = document.createElement(e.href ? 'a' : 'div');
        if (e.href) (row as HTMLAnchorElement).href = e.href;
        row.className = `row k-${e.kind}`;
        const t = document.createElement('b');
        t.textContent = e.title;
        const s = document.createElement('span');
        s.textContent = e.sub;
        row.append(t, s);
        tip.append(row);
      }
      tip.hidden = false;
      const box = root.getBoundingClientRect();
      const b = pin.getBoundingClientRect();
      const x = b.left - box.left + b.width / 2;
      tip.style.left = `${Math.max(8, Math.min(x + 12, box.width - tip.offsetWidth - 8))}px`;
      tip.style.top = `${b.top - box.top + b.height / 2 + 12}px`;
    };
    root.querySelectorAll<SVGGElement>('.pin').forEach((pin) => {
      pin.addEventListener('pointerenter', () => { if (!pinned) show(pin); });
      pin.addEventListener('pointerleave', () => { if (!pinned) tip.hidden = true; });
      pin.addEventListener('focus', () => show(pin));
      // Tap or Enter keeps the card open, so its project links can be followed.
      const hold = () => { pinned = pinned === pin ? null : pin; show(pin); if (!pinned) tip.hidden = true; };
      pin.addEventListener('click', hold);
      pin.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); hold(); } });
    });
    document.addEventListener('pointerdown', (e) => {
      if (pinned && !(e.target as Element).closest('.pin, .atlas-tip')) { pinned = null; tip.hidden = true; }
    });
  }
</script>
