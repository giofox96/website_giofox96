---
import profile from '../data/profile.json';
import { url } from '../lib';
---
<div class="hero">
  <h1>I design <em>rules</em>, not just forms.</h1>
  <p class="lede">
    <strong>{profile.name}, architect and computational designer.</strong>{' '}
    Trained at Politecnico di Bari and NYIT, with field experience in heritage survey and rural restoration.
    Now a technical architect leading parametric modelling, building models that turn site, climate and structure into form.
  </p>
  <div class="stage">
    <canvas
      id="terrain"
      data-src={url('terrain/contours.json')}
      role="img"
      aria-label="Contour map drawn from real elevation data. The contour under the pointer is highlighted with its elevation."
    ></canvas>
    <div class="cap mono">
      <span>Contours from real elevation data, 2 m interval. Move across the map to trace one.</span>
      <span>Traced <b id="elev">415 m</b></span>
    </div>
    <p class="credit mono">Elevation: Mapzen Terrain Tiles, from SRTM and EU-DEM (Copernicus).</p>
  </div>
</div>
<script>
  import { mountTerrain } from '../scripts/terrain';
  const cv = document.getElementById('terrain');
  if (cv instanceof HTMLCanvasElement) {
    // Without the elevation data there is nothing to draw: hide the map rather than show an empty frame.
    mountTerrain(cv).catch(() => { cv.closest<HTMLElement>('.stage')!.hidden = true; });
  }
</script>
