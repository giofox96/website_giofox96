---
// Project space: every project as a circle, placed by how much its themes and tags overlap with
// the others (tag embedding + classical MDS), or on a timeline. The layout is computed at build time.
// The 3D view uses a third MDS axis: the circles become shaded spheres in a cloud you can rotate.
import { getImage } from 'astro:assets';
import { allProjects, projectUrl } from '../lib';
import { embed, embed3, links, relax, themes, themesOf, type Item } from '../scripts/embedding';

const projects = await allProjects();
const items: Item[] = projects.map((p) => ({
  id: p.id,
  text: [p.data.title, p.data.type, ...p.data.tags],
  tags: p.data.tags,
  category: p.data.category,
  year: p.data.year,
}));
const emb = embed(items);
const emb3 = embed3(items);
const radius = (i: number) => (projects[i].data.highlight ? 54 : projects[i].data.featured ? 44 : 32);
const radii = items.map((_, i) => radius(i));
const years = items.map((it) => it.year);
const y0 = Math.min(...years), y1 = Math.max(...years);

const palette = ['#0EA5B7', '#D97706', '#C026D3', '#16A34A', '#4F5BFF', '#EA580C', '#0D9488', '#E11D48', '#7C3AED', '#65A30D', '#0284C7', '#A16207'];
const color = Object.fromEntries(themes.map((t, i) => [t.id, palette[i % palette.length]]));
const nodeThemes = items.map(themesOf);
// Wires between the most similar projects, coloured by the first theme they share.
const wires = links(items).map((w) => ({ ...w, shared: nodeThemes[w.a].filter((t) => nodeThemes[w.b].includes(t)) }));
const r1 = (v: number) => Math.round(v * 10) / 10;
const arc = (p: { x: number; y: number }, q: { x: number; y: number }) => {
  const k = 0.18, mx = (p.x + q.x) / 2, my = (p.y + q.y) / 2;
  return `M${p.x} ${p.y}Q${r1(mx - (q.y - p.y) * k)} ${r1(my + (q.x - p.x) * k)} ${q.x} ${q.y}`;
};

type Box = { w: number; h: number; pad: number };
// Wide: similarity on both axes, timeline left to right. Tall (phones): timeline top to bottom, newest first.
function layout(box: Box, tall: boolean) {
  const s = tall ? 1.1 : 1;
  const r = radii.map((x) => x * s);
  const inner = (v: number, len: number, rr = 0) => box.pad + 70 + ((v + 1) / 2) * (len - 2 * box.pad - 140 - rr);
  const simT = emb.map((p) => ({ x: inner(tall ? p.y : p.x, box.w), y: inner(tall ? p.x : p.y, box.h) }));
  const sim = relax(simT, r, box);
  const t = (y: number) => (y1 - y0 ? (y - y0) / (y1 - y0) : 0.5) * 2 - 1;
  const timeT = emb.map((p, i) =>
    tall ? { x: inner(p.y, box.w), y: inner(-t(years[i]), box.h) } : { x: inner(t(years[i]), box.w), y: inner(p.y, box.h) },
  );
  // Swap axes for relax so the year axis is the pinned one.
  const swap = (q: { x: number; y: number }) => ({ x: q.y, y: q.x });
  const time = tall
    ? relax(timeT.map(swap), r, { w: box.h, h: box.w, pad: box.pad }, 0.3).map(swap)
    : relax(timeT, r, box, 0.3);
  const ticks = Array.from({ length: y1 - y0 + 1 }, (_, k) => {
    const y = y0 + k;
    return { year: y, at: tall ? inner(-t(y), box.h) : inner(t(y), box.w) };
  });
  // A cross for each theme at the mean position of its projects.
  const marks = themes
    .map((th) => {
      const idx = nodeThemes.flatMap((ts, i) => (ts.includes(th.id) ? [i] : []));
      if (!idx.length) return null;
      const m = (k: 'x' | 'y') => idx.reduce((sum, i) => sum + sim[i][k], 0) / idx.length;
      const m3 = [0, 1, 2].map((d) => Math.round((idx.reduce((sum, i) => sum + emb3[i][d], 0) / idx.length) * 1000) / 1000);
      return { ...th, x: Math.round(m('x')), y: Math.round(m('y')), n: idx.length, p3: m3.join(' ') };
    })
    .filter((m) => m !== null);
  return { box, r, sim, time, ticks, marks, tall };
}

const views = [layout({ w: 1000, h: 600, pad: 16 }, false), layout({ w: 600, h: 1000, pad: 16 }, true)];

const covers = await Promise.all(projects.map((p) => getImage({ src: p.data.cover, width: 240, format: 'webp' })));
const counts = themes.map((t) => ({ ...t, n: nodeThemes.filter((ts) => ts.includes(t.id)).length })).filter((t) => t.n);
// Oldest first, so the circles appear in the order the work was done.
const order = items.map((_, i) => i).sort((a, b) => years[a] - years[b]);
const delay = Object.fromEntries(order.map((i, k) => [i, k * 70]));
---
<div class="space" id="space">
  <div class="space-bar">
    <div class="space-filters" role="group" aria-label="Highlight a theme">
      {counts.map((t) => (
        <button type="button" class="chip" data-theme={t.id} aria-pressed="false" style={`--c:${color[t.id]}`}>
          <i aria-hidden="true">+</i>{t.label} <span>{t.n}</span>
        </button>
      ))}
    </div>
    <span class="modes space-mode" role="group" aria-label="View">
      <button type="button" class="chip" data-view="map" aria-pressed="true">2D</button>
      <button type="button" class="chip" data-view="3d" aria-pressed="false">3D</button>
      <button type="button" class="chip" data-view="time" aria-pressed="false">Timeline</button>
    </span>
  </div>
  {views.map((v, vi) => (
    <svg class:list={['space-svg', v.tall ? 'tall' : 'wide']} viewBox={`0 0 ${v.box.w} ${v.box.h}`} role="group" aria-label="Projects placed by shared themes and tags">
      <defs>
        <clipPath id={`disc-${vi}`} clipPathUnits="objectBoundingBox"><circle cx=".5" cy=".5" r=".5" /></clipPath>
        <radialGradient id={`shade-${vi}`} cx=".5" cy=".5" r=".5" fx=".34" fy=".28">
          <stop offset="0" stop-color="#fff" stop-opacity=".6" />
          <stop offset=".32" stop-color="#fff" stop-opacity="0" />
          <stop offset=".7" stop-color="#000" stop-opacity="0" />
          <stop offset="1" stop-color="#000" stop-opacity=".5" />
        </radialGradient>
      </defs>
      <g class="globe" aria-hidden="true"><path /><path /><path /></g>
      <g class="axis" aria-hidden="true">
        {v.ticks.map((tk) =>
          v.tall ? (
            <g transform={`translate(0 ${tk.at})`}><line x1="0" x2="28" /><text x="4" y="-6">{tk.year}</text></g>
          ) : (
            <g transform={`translate(${tk.at} ${v.box.h})`}><line y1="0" y2="-28" /><text x="6" y="-16">{tk.year}</text></g>
          ),
        )}
      </g>
      <g class="wires" aria-hidden="true">
        {wires.map((w) => (
          <path
            class="wire"
            d={arc(v.sim[w.a], v.sim[w.b])}
            data-a={w.a}
            data-b={w.b}
            data-themes={w.shared.join(' ')}
            style={`--c:${w.shared[0] ? color[w.shared[0]] : 'var(--muted)'};--w:${w.w.toFixed(2)}`}
          />
        ))}
      </g>
      {projects.map((p, i) => {
        const r = v.r[i];
        const first = nodeThemes[i][0];
        return (
          <a
            href={projectUrl(p)}
            class="node"
            data-i={i}
            data-p3={emb3[i].join(' ')}
            data-themes={nodeThemes[i].join(' ')}
            data-title={p.data.title}
            data-meta={`${p.data.year} · ${p.data.type}`}
            data-tags={p.data.tags.join(' · ')}
            aria-label={`${p.data.title}, ${p.data.year}`}
            style={`--ex:${v.sim[i].x};--ey:${v.sim[i].y};--tx:${v.time[i].x};--ty:${v.time[i].y};--d:${delay[i]}ms;--c:${first ? color[first] : 'var(--muted)'}`}
          >
            <g class="lens">
              <circle r={r} class="pulse" />
              <g class="bub">
                <circle r={r + 3} class="halo" />
                <image href={covers[i].src} x={-r} y={-r} width={r * 2} height={r * 2} preserveAspectRatio="xMidYMid slice" clip-path={`url(#disc-${vi})`} />
                <circle r={r} class="shade" fill={`url(#shade-${vi})`} />
                <circle r={r} class="ring" />
              </g>
            </g>
          </a>
        );
      })}
      <g class="marks" aria-hidden="true">
        {v.marks.map((m) => (
          <g class="mark" data-theme={m.id} data-p3={m.p3} transform={`translate(${m.x} ${m.y})`} style={`--c:${color[m.id]}`}>
            <path d="M-9 0H9M0 -9V9" />
            <text x="13" y="4">{m.label}</text>
          </g>
        ))}
      </g>
    </svg>
  ))}
  <div class="space-tip mono" role="status" aria-live="polite" hidden></div>
  <p class="space-cap mono">
    <span>Project space · themes and tags embedded with classical MDS: close circles share more.<span class="hint3d"> Drag to rotate.</span></span>
    <span>{projects.length} projects · {counts.length} themes</span>
  </p>
</div>

<script>
  const root = document.getElementById('space');
  if (root) {
    root.classList.add('js');
    const tip = root.querySelector<HTMLElement>('.space-tip')!;
    // Start the pop-in when the space scrolls into view.
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) {
        root.classList.add('on'); io.disconnect();
        // Once every circle has popped in, drop the animation: the 3D view re-stacks the nodes,
        // and moving an element in the DOM would restart it.
        setTimeout(() => root.classList.add('popped'), 2600);
      }
    }, { threshold: 0.25 });
    io.observe(root);

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const three = space3d(root, reduced);
    const modeBtns = [...root.querySelectorAll<HTMLButtonElement>('.space-mode button')];
    let view = 'map';
    modeBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const next = b.dataset.view!;
        if (next === view) return;
        const was = view;
        view = next;
        modeBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        const apply = () => { if (view === next) root.classList.toggle('is-time', next === 'time'); };
        if (next === '3d') { root.classList.remove('is-time'); three.enter(); }
        else if (was === '3d') three.leave(apply);
        else apply();
      }),
    );

    const chips = [...root.querySelectorAll<HTMLButtonElement>('.space-filters .chip')];
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        const same = root.dataset.filter === c.dataset.theme;
        chips.forEach((x) => x.setAttribute('aria-pressed', 'false'));
        if (same) delete root.dataset.filter;
        else { root.dataset.filter = c.dataset.theme; c.setAttribute('aria-pressed', 'true'); }
        root.querySelectorAll<SVGElement>('.node, .mark, .wire').forEach((n) => {
          const ts = (n.dataset.themes ?? n.dataset.theme ?? '').split(' ');
          n.classList.toggle('dim', !!root.dataset.filter && !ts.includes(root.dataset.filter));
        });
      }),
    );

    const wireEls = [...root.querySelectorAll<SVGElement>('.wire')];
    const hot = (i?: string) => {
      root.classList.toggle('has-hot', i !== undefined);
      wireEls.forEach((w) => w.classList.toggle('hot', w.dataset.a === i || w.dataset.b === i));
    };
    const show = (n: SVGElement) => {
      hot(n.dataset.i);
      const box = root.getBoundingClientRect();
      const b = n.getBoundingClientRect();
      tip.innerHTML = '';
      const t = document.createElement('strong');
      t.textContent = n.dataset.title ?? '';
      const m = document.createElement('span');
      m.textContent = n.dataset.meta ?? '';
      tip.append(t, m);
      if (n.dataset.tags) { const g = document.createElement('span'); g.textContent = n.dataset.tags; tip.append(g); }
      tip.hidden = false;
      const x = Math.min(b.right - box.left + 8, box.width - tip.offsetWidth - 8);
      tip.style.left = `${Math.max(8, x)}px`;
      tip.style.top = `${b.top - box.top}px`;
    };
    root.querySelectorAll<SVGElement>('.node').forEach((n) => {
      n.addEventListener('pointerenter', () => show(n));
      n.addEventListener('focus', () => show(n));
      n.addEventListener('pointerleave', () => { tip.hidden = true; hot(); });
      n.addEventListener('blur', () => { tip.hidden = true; hot(); });
    });

    // Fish-eye lens and idle drift: each circle follows a spring toward a target scale and offset.
    // Mouse only, and off for reduced motion; the static layout stays the source of truth.
    if (matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const K = 170, C = 14, R = 190; // spring stiffness, damping; lens radius in SVG units
      const svgs = [...root.querySelectorAll<SVGSVGElement>('.space-svg')].map((svg) => ({
        svg,
        cursor: null as DOMPoint | null,
        nodes: [...svg.querySelectorAll<SVGElement>('.node')].map((n) => ({
          n, lens: n.querySelector<SVGGElement>('.lens')!, phase: Math.random() * 6.283,
          x: 0, y: 0, s: 1, vx: 0, vy: 0, vs: 0,
        })),
      }));
      svgs.forEach((v) => {
        v.svg.addEventListener('pointermove', (e) => {
          v.cursor = new DOMPoint(e.clientX, e.clientY).matrixTransform(v.svg.getScreenCTM()!.inverse());
        });
        v.svg.addEventListener('pointerleave', () => { v.cursor = null; });
      });
      let raf = 0, last = 0;
      const tick = (now: number) => {
        const dt = Math.min((now - (last || now)) / 1000, 0.05);
        last = now;
        const time = root.classList.contains('is-time');
        for (const v of svgs) {
          if (!v.svg.clientWidth) continue;
          for (const o of v.nodes) {
            const st = o.n.style;
            const px = +st.getPropertyValue(time ? '--tx' : '--ex'), py = +st.getPropertyValue(time ? '--ty' : '--ey');
            let tx = Math.sin(now * 0.0006 + o.phase) * 3, ty = Math.cos(now * 0.00042 + o.phase) * 3, ts = 1;
            if (root.classList.contains('is-3d')) { tx = 0; ty = 0; }
            else if (v.cursor) {
              const dx = v.cursor.x - px, dy = v.cursor.y - py, f = Math.max(0, 1 - Math.hypot(dx, dy) / R) ** 2;
              ts += 0.35 * f; tx += dx * 0.18 * f; ty += dy * 0.18 * f;
            }
            o.vx += ((tx - o.x) * K - o.vx * C) * dt; o.x += o.vx * dt;
            o.vy += ((ty - o.y) * K - o.vy * C) * dt; o.y += o.vy * dt;
            o.vs += ((ts - o.s) * K - o.vs * C) * dt; o.s += o.vs * dt;
            o.lens.setAttribute('transform', `translate(${o.x.toFixed(2)} ${o.y.toFixed(2)}) scale(${o.s.toFixed(3)})`);
          }
        }
        raf = requestAnimationFrame(tick);
      };
      // A random circle sends out a ring now and then, so the map looks alive at rest.
      let ping = 0;
      const run = (on: boolean) => {
        cancelAnimationFrame(raf); clearInterval(ping); last = 0;
        if (!on) return;
        raf = requestAnimationFrame(tick);
        ping = window.setInterval(() => {
          const v = svgs.find((s) => s.svg.clientWidth);
          const o = v?.nodes[Math.floor(Math.random() * v.nodes.length)];
          if (!o || o.n.classList.contains('dim')) return;
          o.n.classList.remove('ping'); void o.n.getBoundingClientRect(); o.n.classList.add('ping');
        }, 1800);
      };
      new IntersectionObserver((es) => run(es[0].isIntersecting)).observe(root);
    }
  }

  type V3 = [number, number, number];
  /**
   * The 3D view. Every node keeps its 2D position in CSS; here a third MDS axis lifts it into a
   * cloud that turns slowly and follows the pointer when dragged. Nodes are projected with a simple
   * perspective, scaled and faded by depth, and re-stacked back to front, so the shaded discs read
   * as spheres while the cover images stay flat and legible.
   */
  function space3d(root: HTMLElement, reduced: boolean) {
    const p3 = (el: Element) => (el as HTMLElement).dataset.p3!.split(' ').map(Number) as V3;
    const views = [...root.querySelectorAll<SVGSVGElement>('.space-svg')].map((svg) => {
      const vb = svg.viewBox.baseVal;
      const nodes = [...svg.querySelectorAll<SVGAElement>('.node')].map((n) => ({
        n, lens: n.querySelector<SVGGElement>('.lens')!, p: p3(n),
        ex: +n.style.getPropertyValue('--ex'), ey: +n.style.getPropertyValue('--ey'), x: 0, y: 0, z: 0,
      }));
      return {
        svg, nodes, cx: vb.width / 2, cy: vb.height / 2,
        R: Math.min(vb.width, vb.height) / 2 - 70,
        marksG: svg.querySelector<SVGGElement>('.marks')!,
        globe: [...svg.querySelectorAll<SVGPathElement>('.globe path')],
        wires: [...svg.querySelectorAll<SVGPathElement>('.wire')].map((w) => ({ w, a: +w.dataset.a!, b: +w.dataset.b!, d0: w.getAttribute('d')! })),
        marks: [...svg.querySelectorAll<SVGGElement>('.mark')].map((m) => ({ m, p: p3(m), t0: m.getAttribute('transform')! })),
        order: '',
      };
    });
    // Three great circles for the globe wireframe.
    const ring = (f: (a: number) => V3) => Array.from({ length: 49 }, (_, k) => f((k / 48) * Math.PI * 2));
    const circles = [
      ring((a) => [Math.cos(a), 0, Math.sin(a)]),
      ring((a) => [Math.cos(a), Math.sin(a), 0]),
      ring((a) => [0, Math.sin(a), Math.cos(a)]),
    ];

    let yaw = 0.5, pitch = -0.3, spin = 0.12, vyaw = 0, vpitch = 0;
    let k = 0, goal = 0, raf = 0, last = 0, visible = false, done: (() => void) | null = null;
    let drag: { x: number; y: number; moved: boolean; id: number } | null = null;
    const F = 3.4; // camera distance in units of the cloud's radius

    const project = (v: (typeof views)[number], [x, y, z]: V3) => {
      const cy = Math.cos(yaw), sy = Math.sin(yaw), cp = Math.cos(pitch), sp = Math.sin(pitch);
      const x1 = x * cy + z * sy, z1 = -x * sy + z * cy;
      const y2 = y * cp - z1 * sp, z2 = y * sp + z1 * cp;
      const s = F / (F - z2);
      return { x: v.cx + x1 * v.R * s, y: v.cy + y2 * v.R * s, s, z: z2 };
    };
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);

    const frame = (now: number) => {
      const dt = Math.min((now - (last || now)) / 1000, 0.05);
      last = now;
      k = reduced ? goal : Math.max(0, Math.min(1, k + (goal ? dt : -dt) / 0.8));
      if (!drag) {
        const idle = !reduced && !root.classList.contains('has-hot');
        yaw += (vyaw + (idle ? spin : 0)) * dt;
        pitch = Math.max(-1.2, Math.min(1.2, pitch + vpitch * dt));
        vyaw *= 0.94; vpitch *= 0.94;
      }
      const e = ease(k);
      for (const v of views) {
        if (!v.svg.clientWidth) continue;
        for (const o of v.nodes) {
          const q = project(v, o.p);
          o.x = o.ex + (q.x - o.ex) * e; o.y = o.ey + (q.y - o.ey) * e; o.z = q.z;
          const s = 1 + (q.s * 0.72 - 1) * e;
          o.n.style.transform = `translate(${o.x.toFixed(1)}px, ${o.y.toFixed(1)}px) scale(${s.toFixed(3)})`;
          o.lens.style.opacity = (1 - e * (1 - (0.4 + 0.6 * (q.z + 1) / 2))).toFixed(2);
        }
        // Back to front, just before the theme marks.
        const sorted = [...v.nodes].sort((a, b) => a.z - b.z);
        const key = sorted.map((o) => o.n.dataset.i).join();
        if (key !== v.order) { v.order = key; sorted.forEach((o) => v.svg.insertBefore(o.n, v.marksG)); }
        for (const w of v.wires) {
          const a = v.nodes[w.a], b = v.nodes[w.b];
          w.w.setAttribute('d', `M${a.x.toFixed(1)} ${a.y.toFixed(1)}L${b.x.toFixed(1)} ${b.y.toFixed(1)}`);
        }
        for (const m of v.marks) {
          const q = project(v, m.p);
          const [, tx, ty] = m.t0.match(/translate\(([-\d.]+) ([-\d.]+)\)/)!.map(Number);
          m.m.setAttribute('transform', `translate(${(tx + (q.x - tx) * e).toFixed(1)} ${(ty + (q.y - ty) * e).toFixed(1)})`);
        }
        v.globe.forEach((g, gi) => {
          g.setAttribute('d', circles[gi].map((p, j) => { const q = project(v, p); return `${j ? 'L' : 'M'}${q.x.toFixed(1)} ${q.y.toFixed(1)}`; }).join(''));
        });
      }
      if (k === 0 && goal === 0) { reset(); return; }
      raf = visible ? requestAnimationFrame(frame) : 0;
    };
    const start = () => { if (!raf && visible) { last = 0; raf = requestAnimationFrame(frame); } };
    // Back to the CSS layout: inline styles off, original paths and stacking restored.
    const reset = () => {
      raf = 0;
      for (const v of views) {
        for (const o of v.nodes) { o.n.style.transform = ''; o.lens.style.opacity = ''; v.svg.insertBefore(o.n, v.marksG); }
        v.order = '';
        v.wires.forEach((w) => w.w.setAttribute('d', w.d0));
        v.marks.forEach((m) => m.m.setAttribute('transform', m.t0));
      }
      root.classList.remove('is-3d');
      done?.(); done = null;
    };

    new IntersectionObserver((es) => {
      visible = es[0].isIntersecting;
      if (visible && root.classList.contains('is-3d')) start();
      else if (!visible) { cancelAnimationFrame(raf); raf = 0; }
    }).observe(root);

    for (const v of views) {
      v.svg.addEventListener('pointerdown', (e) => {
        if (!root.classList.contains('is-3d') || e.button) return;
        drag = { x: e.clientX, y: e.clientY, moved: false, id: e.pointerId };
        vyaw = 0; vpitch = 0;
      });
      v.svg.addEventListener('pointermove', (e) => {
        if (!drag || e.pointerId !== drag.id) return;
        const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
        if (!drag.moved && Math.hypot(dx, dy) < 5) return;
        // Capture only once it is a drag, so a tap on a sphere still opens the project.
        if (!drag.moved) { drag.moved = true; v.svg.setPointerCapture(e.pointerId); root.classList.add('dragging'); }
        const unit = 3 / v.svg.clientWidth;
        yaw += dx * unit; pitch = Math.max(-1.2, Math.min(1.2, pitch - dy * unit));
        vyaw = (dx * unit) * 60; vpitch = (-dy * unit) * 60;
        drag.x = e.clientX; drag.y = e.clientY;
        start();
      });
      const end = (e: PointerEvent) => {
        if (!drag || e.pointerId !== drag.id) return;
        const moved = drag.moved;
        drag = null;
        root.classList.remove('dragging');
        if (moved) {
          // Swallow the click that ends a drag.
          v.svg.addEventListener('click', (c) => { c.preventDefault(); c.stopPropagation(); }, { capture: true, once: true });
        }
      };
      v.svg.addEventListener('pointerup', end);
      v.svg.addEventListener('dragstart', (e) => { if (root.classList.contains('is-3d')) e.preventDefault(); });
      v.svg.addEventListener('pointercancel', (e) => { if (drag?.id === e.pointerId) { drag = null; root.classList.remove('dragging'); } });
    }

    return {
      enter() {
        done = null;
        root.classList.add('is-3d', 'popped');
        goal = 1;
        start();
      },
      leave(then: () => void) {
        goal = 0;
        done = then;
        if (!raf) { k = 0; reset(); }
        else if (reduced) k = 0;
      },
    };
  }
</script>
