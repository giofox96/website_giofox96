---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/instrument-sans';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import profile from '../data/profile.json';
import { url } from '../lib';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Giovanni Carlo Volpe, architect and computational designer from Puglia. Parametric modelling, form-finding and architecture.',
  image,
} = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name}, architect and computational designer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const is404 = /\/404\/?$/.test(Astro.url.pathname);
const ogImage = new URL(image ?? url('og.jpg'), Astro.site);
const home = url();
const nav = [
  ['Computational', 'computational'],
  ['Architecture', 'architecture'],
  ['Experience', 'experience'],
  ['About', 'about'],
  ['Contact', 'contact'],
];
const link = (label: string) => profile.links.find((l) => l.label === label)?.url;
const linkedin = link('LinkedIn');
const instagram = link('Instagram');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!is404 && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content="#EDEFF3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F1118" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!is404 && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        var t = localStorage.getItem('pf-theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap">
      <header class="top">
        <a class="brand" href={home}>{profile.name}</a>
        <nav class="nav" aria-label="Sections">
          {nav.map(([label, id]) => <a href={`${home}#${id}`} data-sec={id}>{label}</a>)}
        </nav>
        <div class="top-tools">
          <a class="pill" href="https://github.com/giofox96" target="_blank" rel="noopener" aria-label="GitHub profile (opens in a new tab)">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            GitHub
          </a>
          {linkedin && (
            <a class="pill icon" href={linkedin} target="_blank" rel="noopener" aria-label="LinkedIn profile (opens in a new tab)" title="LinkedIn">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M0 1.15C0 .52.53 0 1.18 0h13.64C15.47 0 16 .52 16 1.15v13.7c0 .63-.53 1.15-1.18 1.15H1.18C.53 16 0 15.48 0 14.85V1.15zm4.94 12.24V6.17H2.54v7.22h2.4zM3.74 5.18c.84 0 1.36-.55 1.36-1.25-.02-.71-.52-1.25-1.34-1.25-.82 0-1.36.54-1.36 1.25 0 .7.52 1.25 1.33 1.25h.01zm4.91 8.21V9.36c0-.22.02-.43.08-.59.18-.43.57-.88 1.23-.88.87 0 1.21.66 1.21 1.63v3.87h2.4V9.25c0-2.22-1.18-3.25-2.76-3.25-1.27 0-1.84.7-2.16 1.19v.03h-.02l.02-.03V6.17h-2.4c.03.68 0 7.22 0 7.22h2.4z"/></svg>
            </a>
          )}
          {instagram && (
            <a class="pill icon" href={instagram} target="_blank" rel="noopener" aria-label="Instagram profile (opens in a new tab)" title="Instagram">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 0C5.83 0 5.56.01 4.7.05 3.85.09 3.27.22 2.76.42c-.53.21-.98.48-1.42.92-.44.45-.72.9-.92 1.42-.2.51-.33 1.09-.37 1.94C.01 5.56 0 5.83 0 8s.01 2.44.05 3.3c.04.85.17 1.43.37 1.94.2.53.48.98.92 1.42.45.44.9.72 1.42.92.51.2 1.09.33 1.94.37.86.04 1.13.05 3.3.05s2.44-.01 3.3-.05c.85-.04 1.43-.17 1.94-.37.53-.2.98-.48 1.42-.92.44-.45.72-.9.92-1.42.2-.51.33-1.09.37-1.94.04-.86.05-1.13.05-3.3s-.01-2.44-.05-3.3c-.04-.85-.17-1.43-.37-1.94a3.9 3.9 0 00-.92-1.42A3.9 3.9 0 0013.24.42C12.73.22 12.15.09 11.3.05 10.44.01 10.17 0 8 0zm0 1.44c2.14 0 2.39.01 3.23.05.78.04 1.2.17 1.48.27.37.15.64.32.92.6.28.28.45.55.6.92.1.28.23.7.27 1.48.04.84.05 1.1.05 3.23s-.01 2.39-.05 3.23c-.04.78-.17 1.2-.27 1.48-.15.37-.32.64-.6.92a2.5 2.5 0 01-.92.6c-.28.1-.7.23-1.48.27-.84.04-1.1.05-3.23.05s-2.39-.01-3.23-.05c-.78-.04-1.2-.17-1.48-.27a2.5 2.5 0 01-.92-.6 2.5 2.5 0 01-.6-.92c-.1-.28-.23-.7-.27-1.48C1.45 10.39 1.44 10.14 1.44 8s.01-2.39.05-3.23c.04-.78.17-1.2.27-1.48.15-.37.32-.64.6-.92.28-.28.55-.45.92-.6.28-.1.7-.23 1.48-.27.84-.04 1.1-.05 3.23-.05zM8 3.89a4.11 4.11 0 100 8.22 4.11 4.11 0 000-8.22zm0 6.78a2.67 2.67 0 110-5.34 2.67 2.67 0 010 5.34zm5.23-6.94a.96.96 0 11-1.92 0 .96.96 0 011.92 0z"/></svg>
            </a>
          )}
          <button class="chip" id="sound" type="button" aria-pressed="false" aria-label="Background music" title="Background music">♪</button>
          <button class="chip" id="theme" type="button" aria-label="Switch between light and dark theme">◐</button>
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="foot mono">
        <span>© {new Date().getFullYear()} {profile.name}. {profile.role}.</span>
        <span>{profile.location}</span>
      </footer>
    </div>
    <script>
      import '../scripts/site';
      import '../scripts/sound';
    </script>
  </body>
</html>
