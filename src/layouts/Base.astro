---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/instrument-sans';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import profile from '../data/profile.json';
import { url } from '../lib';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Giovanni Carlo Volpe, architect and computational designer from Puglia. Parametric modelling, form-finding and architecture.',
  image,
} = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name}, architect and computational designer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const is404 = /\/404\/?$/.test(Astro.url.pathname);
const ogImage = new URL(image ?? url('og.jpg'), Astro.site);
const home = url();
const nav = [
  ['Computational', 'computational'],
  ['Architecture', 'architecture'],
  ['Experience', 'experience'],
  ['About', 'about'],
  ['Contact', 'contact'],
];
// Side index: every home section, numbered like the section labels.
const index = [
  ['00', 'Overview', 'space-sec'],
  ['01', 'Computational', 'computational'],
  ['02', 'Architecture', 'architecture'],
  ['03', 'Index', 'other'],
  ['04', 'Experience', 'experience'],
  ['05', 'About', 'about'],
  ['06', 'Contact', 'contact'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!is404 && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content="#EDEFF3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F1118" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!is404 && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        var t = localStorage.getItem('pf-theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap">
      <header class="top">
        <a class="brand" href={home}>{profile.name}</a>
        <nav class="nav" aria-label="Sections">
          {nav.map(([label, id]) => <a href={`${home}#${id}`}>{label}</a>)}
        </nav>
        <div class="top-tools">
          <a class="pill" href="https://github.com/giofox96" target="_blank" rel="noopener" aria-label="GitHub profile (opens in a new tab)">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            GitHub
          </a>
          <button class="chip" id="sound" type="button" aria-pressed="false" aria-label="Background music" title="Background music">♪</button>
          <button class="chip" id="theme" type="button" aria-label="Switch between light and dark theme">◐</button>
        </div>
      </header>

      <aside class="side" id="side" aria-label="Section index">
        <button class="chip side-toggle" id="side-toggle" type="button" aria-expanded="false" aria-controls="side-list">Menu</button>
        <ol class="side-list" id="side-list">
          {index.map(([n, label, id]) => (
            <li><a href={`${home}#${id}`} data-sec={id}><span class="mono">{n}</span>{label}</a></li>
          ))}
          <li class="side-up"><a href="#main" data-top><span class="mono">↑</span>Top</a></li>
        </ol>
      </aside>

      <main id="main">
        <slot />
      </main>

      <footer class="foot mono">
        <span>© {new Date().getFullYear()} {profile.name}. {profile.role}.</span>
        <span>{profile.location}</span>
      </footer>
    </div>
    <script>
      import '../scripts/site';
      import '../scripts/sound';
    </script>
  </body>
</html>
